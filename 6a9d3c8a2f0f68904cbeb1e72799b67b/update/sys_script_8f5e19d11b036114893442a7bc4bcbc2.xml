        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

    var userId = gs.getUserID();
    var grUser = new GlideRecord('sys_user');

    var url = gs.action.getGlideURI().toString();

    var ticketPage = url.indexOf('table=x_hccc_hoc_ohs_telework_agreement');

    // if it's the ticket page, we do not need to filter more
    if (ticketPage != -1) {
        return;
    }

    var index = url.indexOf('id=hoc_ohsm_telework_agreement_requests');

    grUser.get(userId);

    var qc = current.addQuery("employee_service_area", grUser.department.business_unit.toString()); //.addOrCondition("manager_name", userId.toString());

    if (index >= 0) {
        qc.addOrCondition("manager_name", userId.toString());
    }

})(current, previous);]]></script>
