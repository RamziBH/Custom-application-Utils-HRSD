        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

        // Add your code here
        gs.info('Script executed for Harassment and Violence Complaint');
        var grHrParentCase = new GlideRecord("x_hccc_hoc_ohs_investigation_case");
        grHrParentCase.get( current.parent.sys_id);

        var grHrTask2 = new GlideRecord("sn_hr_core_task");
        grHrTask2.addEncodedQuery("parent=" +current.parent.sys_id + "^state!=3");
        grHrTask2.query();
        if (!grHrTask2.hasNext()) {
           
            grHrParentCase.state=  113; //Mediation in progress	
			grHrParentCase.update();
    }
})(current, previous);]]></script>
