        <name>Send to OHS</name>
        <onclick/>
        <order>110</order>
        <script><![CDATA[//check if there are any hazards/risks identified.
var risks = new GlideRecord('x_hccc_hoc_ohs_hazard_investigation_and_risk_assessment');
risks.setWorkflow(false);
risks.addQuery('hira_case', current.sys_id);
risks.query();

if (risks.next()) {
    current.state = 104;
    current.assigned_to = '';
    current.assignment_group = '13e4414a2f4f68904cbeb1e72799b6f1'; //CEH-HRS-OHS-Advisors

    current.update();
    action.setRedirectURL(current);
} else {
	gs.addInfoMessage(gs.getMessage("x_hccc_hoc_ohs.cannot_submit_hira_without_risk"));
	current.update();
	action.setRedirectURL(current);
}
	]]></script>
