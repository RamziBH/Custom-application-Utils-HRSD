<?xml version="1.0" encoding="UTF-8"?><record_update table="sys_ui_page">
    <sys_ui_page action="INSERT_OR_UPDATE">
        <category>general</category>
        <client_script><![CDATA[function submitCancel() {
	$("button_clicked").value = 'cancel';
	$("case_notes").value = '';
	GlideDialogWindow.get().destroy();
	return false;
}

function submitOk() {
	var case_notes = gel("case_notes").value;
	case_notes = trim(case_notes);
    if (case_notes == ''){
		alert('Please provide case notes');
		return false;
	}	
	GlideDialogWindow.get().destroy();
	g_form.setDisplay('close_notes', true);
	g_form.setValue('close_notes', case_notes);
	returnFromDialog();
		
}

]]></client_script>
        <description/>
        <direct>false</direct>
        <endpoint>x_hccc_hoc_ohs_hoc_ohs_close_notes.do</endpoint>
        <html><![CDATA[<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
