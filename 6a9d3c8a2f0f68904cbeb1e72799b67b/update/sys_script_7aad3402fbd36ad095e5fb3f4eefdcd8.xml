        <collection>x_hccc_hoc_ohs_investigation_case</collection>
        <condition/>
        <description>Add NA as a default value under the Witnesses   field in the  Lab 1070 report  report when no Witnesses  are available </description>
        <execute_function>false</execute_function>
        <filter_condition table="x_hccc_hoc_ohs_investigation_case">hr_service=6a2b1ada2f4f2c904cbeb1e72799b6ae^EQ<item endquery="true" field="" goto="false" newquery="false" operator="=" or="false" value=""/>
        </filter_condition>
        <is_rest>false</is_rest>
        <message/>
        <name>HoC - Add Witnesses value NA in the  Lab</name>
        <order>100</order>
        <priority>100</priority>
        <rest_method/>
        <rest_method_text/>
        <rest_service/>
        <rest_service_text/>
        <rest_variables/>
        <role_conditions/>
        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    
    var witnesses = current.getValue('inc_witnesses');

    function removeNA(witness){
        witness = witness
            .split(',')                    
            .map(function(item) { return item.trim(); }) 
            .filter(function(item) { return item.toUpperCase() !== 'NOT AVAILABLE'; })
            .join(', '); 
        return  witness;
    }

    // Only set NA if the field is empty
    if (!witnesses || witnesses.trim() === '') {
        current.setValue('inc_witnesses', 'not available');
    } else {
        current.setValue('inc_witnesses', removeNA(witnesses));
    }

})(current, previous);]]></script>
