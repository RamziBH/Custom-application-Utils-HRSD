        <script><![CDATA[(function() {
    current.type = "Accommodation";

    if (producer.type_of_request.toString() == "Medical" || producer.type_of_request.toString() == "Raison médicale") {

        new x_hccc_hoc_ohs.HoCOHSRecordProducerUtil().createCaseFromProducer(current, producer, cat_item.sys_id);
        producer.portal_redirect = "?id=hoc_accommodation_confirmation_case&requestNumber=" + current.number;
		
    } else {

        var user = new GlideRecord('sys_user');

        user.get('sys_id', gs.getUserID());

        var user_location = new GlideRecord('cmn_location');

        user_location.get('sys_id', producer.location.toString());


        var email_info = {
            employee_name : user.getValue('name'),
            location : user_location.getValue('name'),
            type_of_request : producer.type_of_request.toString(),
            other_type: producer.other_type.toString(),
            describe_how_your_needs_impact_your_ability : producer.impact_your_ability.toString(),
            describe_how_your_needs_could_be_met_with_accommodation : producer.met_with_an_accommodation.toString()
        }

        gs.eventQueue('x_hccc_hoc_ohs.hoc_ohs_accommodation_notifications',user, producer.manager.email, JSON.stringify(email_info));

        producer.portal_redirect = "?id=hoc_ohsm_accommodation_confirmation";

        current.setAbortAction(true);
    }
})();]]></script>
