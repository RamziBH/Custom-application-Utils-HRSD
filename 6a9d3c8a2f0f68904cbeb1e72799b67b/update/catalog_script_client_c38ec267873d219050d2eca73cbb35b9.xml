	var ga = new GlideAjax('x_hccc_hoc_ohs.HoCOHSMTelWrkUtils'); 
	ga.addParam('sysparm_name', 'getServiceArea'); 
	ga.addParam('sysparm_employee_sys_id', emp); 
    ga.getXMLAnswer(resultServiceArea);
	
	// GlideAjax callback function
	function resultServiceArea(answer) {
		if (answer != "") g_form.setValue("employee_service_area", answer);
	}
}]]></script>
