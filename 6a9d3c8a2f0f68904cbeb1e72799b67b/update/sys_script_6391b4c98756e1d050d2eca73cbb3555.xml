        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	// If Approval == "Requested", set State to "Awaiting approval"
	if (current.approval == "requested") {
		current.state = 11;
		current.update();
	}
	// If Approval == "Approved", set State to "Closed/complete"
	else if (current.approval == "approved") {
		current.state = 3;
		current.update();
	}
	// If Approval == "Rejected", set State to "Modify"
	else if (current.approval == "rejected") {
		current.state = 30;
		current.update();
	}
})(current, previous);]]></script>
