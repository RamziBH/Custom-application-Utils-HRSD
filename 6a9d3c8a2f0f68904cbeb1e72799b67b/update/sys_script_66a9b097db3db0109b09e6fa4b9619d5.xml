        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	// Add your code here
	
	var hrc = new GlideRecord('x_hccc_hoc_ohs_investigation_case');
	hrc.get(current.getValue('parent'));
	hrc.setValue('sc_employee_has_signed_lab1060','yes'); 
	
	var empDec = hrc.getValue('emp_agree_2');
	if (hrc.getValue('man_agrees_with_result_2') !== null){
		
		if(empDec=='Yes' && hrc.getValue('man_agrees_with_result_2') == "Yes"){
			hrc.setValue('state','106'); //Investigation Complete - Internal
		} 
		else{
			hrc.setValue('state','204'); //Needs Minister of Labour Review
		}
	}
	hrc.update();

})(current, previous);]]></script>
