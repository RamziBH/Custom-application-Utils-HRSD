        <script><![CDATA[//TODO: Must make sure all hazards are implemented
var hira = new GlideRecord('x_hccc_hoc_ohs_hazard_investigation_and_risk_assessment');
hira.setWorkflow(false);
hira.addQuery('hira_case', current.sys_id);
hira.addQuery('state','!=', 30);
hira.query();

//If any record exist, it means the measure's implementation if not completed
var not_completed = false;
while(hira.next()){
	gs.addErrorMessage(gs.getMessage("x_hccc_hoc_ohs.mitigation_measures_not_implemented"));
	not_completed=true;
	action.setRedirectURL(current);
}

if (not_completed==false){
	current.state = 952;
}

current.update();
action.setRedirectURL(current);]]></script>
