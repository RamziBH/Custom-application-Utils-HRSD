        <script><![CDATA[(function() {
    new sn_hr_le.hr_ActivityUtils().createCaseFromProducer(current, producer, cat_item.sys_id);

    producer.portal_redirect = "?id=hoc_ohsm_confirmation&requestNumber=" + current.number;

    var objInjury = JSON.parse(producer.area_of_injury);
    var lengthInjueries = objInjury.length;

    var finalInjuriesValue = "";
    try {

        if (lengthInjueries > 0) {
            for (var i = 0; i < lengthInjueries; i++) {


                if (objInjury[i].injury_location === undefined) { //Means that the selection does not require "left", "right" or "both"
                    if (objInjury[i].injury_other === undefined) { //Means that we did not selected "other"
                        finalInjuriesValue += objInjury[i].area_of_injury_box;
                    } else {
                        finalInjuriesValue += objInjury[i].area_of_injury_box + " (" + objInjury[i].injury_other + ")";
                    }
                } else {
                    finalInjuriesValue += objInjury[i].area_of_injury_box + ": " + objInjury[i].injury_location;
                }
                if (i != lengthInjueries - 1) {
                    finalInjuriesValue += ",\n"; //If not the last line, add comma and break line
                }
            }
        }
    } catch (ex) {
        gs.error("*****CATCH: HAZARDS" + ex);
    }
    current.manager_name = producer.opened_for;
    current.area_of_injury = finalInjuriesValue;
    current.inc_location = producer.inc_location != "" ? producer.inc_location : producer.inc_working_location != "" ? producer.inc_working_location : producer.inc_home_building;
    current.case_location_as_entered = current.inc_location;
    //current.inc_location = producer.inc_location != "" ? producer.inc_location:producer.inc_working_location;
    //current.opened_for=producer.manager_name;

})();]]></script>
