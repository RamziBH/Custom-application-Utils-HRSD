        <name>Copy to review</name>
        <onclick/>
        <order>-200</order>
        <script><![CDATA[/* global action, x_hccc_hoc_ohs */

function copy(oldCaseGR) {
    var hiraUtil = new x_hccc_hoc_ohs.HoCOHSMHIRAUtils();
    var hira_record = hiraUtil.copyCase(oldCaseGR, 'case copied for review');

    return hira_record;
}

var newRecord = copy(current);

if (gs.nil(newRecord)) { //JSUtil.nil(newRecord) or gs.nil(newRecord)
    gs.addErrorMessage('Failed to copy case');
    action.setRedirectURL(current);
    action.setReturnURL(current);
} else {
    // redirect to the copy we just created
    gs.addInfoMessage('created from ' + current.number);
    //gs.setRedirect(newRecord);
    action.setRedirectURL(newRecord);
    action.setReturnURL(current);
}]]></script>
