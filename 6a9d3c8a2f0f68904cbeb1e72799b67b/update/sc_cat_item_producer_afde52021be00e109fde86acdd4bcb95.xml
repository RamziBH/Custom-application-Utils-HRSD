        <tablename>sc_cat_item_producer</tablename>
        <value>&lt;p&gt;&lt;span style="font-family: arial, helvetica, sans-serif; font-size: 12pt;"&gt;​&lt;strong&gt;L'&amp;eacute;valuation des risques de harc&amp;egrave;lement et de violence sur le lieu de travail&lt;/strong&gt; est un processus structur&amp;eacute; qui permet d'identifier, d'&amp;eacute;valuer et de r&amp;eacute;duire les risques li&amp;eacute;s au harc&amp;egrave;lement et &amp;agrave; la violence sur le lieu de travail. Elle est con&amp;ccedil;ue pour assurer un environnement de travail s&amp;ucirc;r et respectueux pour tous les employ&amp;eacute;s. Cette &amp;eacute;valuation est une obligation l&amp;eacute;gale et doit &amp;ecirc;tre men&amp;eacute;e tous les trois ans, &amp;agrave; la suite d'un avis d'incident avec une tiers partie ou &amp;agrave; chaque fois que des changements importants interviennent sur le lieu de travail.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&#13;
&lt;p&gt;&lt;span style="font-family: arial, helvetica, sans-serif; font-size: 12pt;"&gt;Le repr&amp;eacute;sentant d&amp;eacute;sign&amp;eacute; de l'employeur doit effectuer cette &amp;eacute;valuation, en collaboration avec le comit&amp;eacute; local de sant&amp;eacute; et de s&amp;eacute;curit&amp;eacute; au travail.&lt;/span&gt;&lt;/p&gt;&#13;
&lt;p&gt;&lt;strong&gt;&lt;span style="font-family: arial, helvetica, sans-serif; font-size: 12pt;"&gt;Veuillez compl&amp;eacute;ter le gabarit ci-dessous et le joindre &amp;agrave; la fin de ce formulaire en cliquant sur l'ic&amp;ocirc;ne repr&amp;eacute;sentant un trombone obligatoire.&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;&#13;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;&#13;
&lt;p&gt;&lt;span style="font-size: 12pt; font-family: arial, helvetica, sans-serif; color: #3598db;"&gt;&lt;a style="color: #3598db;" href="/sys_attachment.do?sys_id=9ef7c6c63b719290aeb1ebc964e45a56" target="_blank" rel="noopener noreferrer nofollow"&gt;Outil d'&amp;eacute;valuation des risques d&amp;rsquo;harc&amp;egrave;lement et de violence au travail&lt;/a&gt; &lt;/span&gt;&lt;/p&gt;</value>
    </sys_translated_text>
