        <name>Mitigation measures completed</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[/* global action, HoCOHSMHIRAUtils*/
var formCompleted = true;
var fieldsToComplete = [
    //'recommended_action', //removed as part of PBI#190942
    'controls_present', //added as part of PBI#190942
    'mitigated_likelihood',
    'mitigated_severity'
];

for (var i = 0; i < fieldsToComplete.length; i++) {
    var label = current.getElement(fieldsToComplete[i]).getLabel();

    if (current.getElement(fieldsToComplete[i]).nil()) {
        formCompleted = false;
        gs.addErrorMessage(gs.getMessage("x_hccc_hoc_ohs.hazard_element_missing_value", label));
    }
}

if (!new HoCOHSMHIRAUtils().areMitigationsCompleted(current)) {
    formCompleted = false;
    gs.addErrorMessage(gs.getMessage("x_hccc_hoc_ohs.hira.mitigations_incomplete"));
}

if (formCompleted === true) {
    current.state = 30; //Complete
}

current.update();
action.setRedirectURL(current);]]></script>
